# =========================================================
# AI Research Paper Aggregator - Environment Configuration
# =========================================================

# --- Database Connection (Supabase / Neon / Render Postgres) ---
# Unified connection string provided by Supabase / Neon / Render:
DATABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres

# --- Local Postgres Fallback (docker-compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=research_db
DB_USER=aggregator_user
DB_PASSWORD=super_secure_password123

# --- Gemini API Key ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email Dispatch ---
# Recommended for Cloud Deployments (Render Free Tier blocks outbound SMTP ports 25/465/587):
RESEND_API_KEY=your_resend_api_key_here
# Optional alternative HTTP API:
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=onboarding@resend.dev


# --- SMTP Fallback (For Local Dev / Hosts allowing SMTP) ---
MY_EMAIL=your_email@gmail.com
APP_PASSWORD=your_gmail_app_password

